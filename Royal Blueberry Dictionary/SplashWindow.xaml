<Window x:Class="Royal_Blueberry_Dictionary.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Royal Blueberry Dictionary"
        Icon="/Resources/Image/app.ico"
        Width="280"
        Height="280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Topmost="True">

    <Border Background="#1A2D6D"
            CornerRadius="24"
            BorderBrush="#2D4ACC"
            BorderThickness="1"
            Padding="36">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <Image Width="120"
                   Height="120"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   Source="/Resources/Image/logo.png">
                <Image.Clip>
                    <EllipseGeometry Center="60,60" RadiusX="60" RadiusY="60"/>
                </Image.Clip>
            </Image>
            <TextBlock Text="Royal Blueberry Dictionary"
                       Margin="0,18,0,0"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="White"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
