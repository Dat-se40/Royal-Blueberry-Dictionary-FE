<Window x:Class="Royal_Blueberry_Dictionary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Royal Blueberry Dictionary" Height="600" Width="1000"
        
        Background="{DynamicResource MainBackground}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource AppFontSize}">

    <Grid>
        <Border x:Name="Overlay"
                Background="#80000000"
                Visibility="Collapsed"
                Panel.ZIndex="99"
                MouseDown="Overlay_MouseDown"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource NavbarBackground}"
                    Padding="15"
                    Effect="{StaticResource NavbarShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="HamburgerBtn"
                            Style="{StaticResource HamburgerButtonStyle}"
                            Margin="0,0,10,0"
                            Click="HamburgerBtn_Click"/>

                    <Button Grid.Column="1" x:Name="BackBtn"
        Click="BackBtn_Click_1"
        Style="{StaticResource NavButtonStyle}"
        IsEnabled="{Binding ElementName=MainFrame, Path=CanGoBack}"
        Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource IconGlyphMd}" Text="&#xE76B;"/>
                    </Button>

                    <Button Grid.Column="2" x:Name="ForwardBtn"
        Click="ForwardBtn_Click_1"
        Style="{StaticResource NavButtonStyle}"
        IsEnabled="{Binding ElementName=MainFrame, Path=CanGoForward}"
        Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource IconGlyphMd}" Text="&#xE76C;"/>
                    </Button>

                    <Button Grid.Column="3" x:Name="ReloadBtn"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="0,0,20,0"
                            Click="ReloadBtn_Click">
                        <TextBlock Style="{StaticResource IconGlyphMd}" Text="&#xE72C;"/>
                    </Button>

                    <Grid x:Name="SearchArea" Grid.Column="4" MaxWidth="700" HorizontalAlignment="Stretch" Margin="20,0">
                        <Border Background="{DynamicResource SearchBackground}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="2"
                                CornerRadius="25"
                                Padding="15,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource IconGlyphMd}"
                                           Text="&#xE721;"
                                           Foreground="{DynamicResource SearchIcon}"
                                           Margin="0,0,10,0"/>

                                <TextBox Grid.Column="1" x:Name="SearchInput" Style="{StaticResource SearchTextBoxStyle}"
                                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding ExecuteSearchCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>

                                <Button Grid.Column="2" x:Name="SearchBtn"  
                                        Content="{Binding StatusText}"
                                        Style="{StaticResource SearchButtonStyle}"
                                        Margin="10,0,0,0"
                                        Command="{Binding ExecuteSearchCommand}"/>
                            </Grid>
                        </Border>

                        <Popup x:Name="SuggestionsPopup" PlacementTarget="{Binding ElementName=SearchInput}"
                            Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{Binding IsSuggestionsOpen}" StaysOpen="False">
                            <Border Background="{DynamicResource SuggestionsBackground}"
            BorderBrush="{DynamicResource SuggestionsBorder}"
            BorderThickness="2" 
            CornerRadius="0"
            Width="{Binding ElementName=SearchInput, Path=ActualWidth}" >
                                <ListBox x:Name="SuggestionsList"
                 ItemsSource="{Binding Suggestions}"
                 Background="Transparent" 
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Padding="2,0">
                                                <TextBlock.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.SelectSuggestionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}"/>
                                                </TextBlock.InputBindings>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>

                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="10,8"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="ItemBorder"
                                                                Background="{TemplateBinding Background}"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ButtonColor}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ButtonColor}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>

                    <Border Grid.Column="5" x:Name="ThemeToggle"
                            Width="70" Height="34"
                            Background="{DynamicResource ThemeToggleBackground}"
                            CornerRadius="17" Cursor="Hand"
                            MouseLeftButtonDown="ThemeToggle_MouseLeftButtonDown">
                        <Canvas>
                            <Border x:Name="ThemeSlider" Width="28" Height="28"
                                    Background="{DynamicResource ThemeSliderBackground}"
                                    CornerRadius="14" Canvas.Left="3" Canvas.Top="3">
                                <TextBlock x:Name="ThemeIcon"
                                           FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE706;" FontSize="14"
                                           Foreground="{DynamicResource ThemeIconColor}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Canvas>
                    </Border>
                </Grid>
            </Border>

            <Frame Grid.Row="1" x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
        </Grid>

        <Border x:Name="Sidebar" Width="280" HorizontalAlignment="Left"
                Background="{DynamicResource SidebarBackground}"
                Panel.ZIndex="100" Effect="{StaticResource SidebarShadow}">
            <Border.RenderTransform>
                <TranslateTransform X="-280"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource NavbarBackground}" Padding="22">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource IconGlyphMd}" Text="&#xE82D;"
                                       Foreground="White" Margin="0,0,8,0"/>
                            <TextBlock Text="Dictionary" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="Quick Access Menu" FontSize="12" Foreground="White" Opacity="0.9" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        <Border Margin="0,16,0,0"
                                Padding="12,10"
                                CornerRadius="14"
                                Background="#1AFFFFFF"
                                BorderBrush="#2EFFFFFF"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="SidebarUserStatus"
                                           Text="Guest mode"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           TextAlignment="Center"/>
                                <TextBlock x:Name="SidebarUserHint"
                                           Text="Open Account to sign in"
                                           FontSize="11"
                                           Foreground="White"
                                           Opacity="0.78"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,20,0,0">
                        <Button Style="{StaticResource SidebarButtonStyle}" Tag="Home" Click="SideBarNavigate">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyphMd}" Text="&#xE80F;"
                                           Foreground="{DynamicResource ButtonColor}"
                                           Margin="0,0,15,0" Width="24"/>
                                <TextBlock Text="Home" FontSize="15" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}" Tag="History" Click="SideBarNavigate">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyphMd}" Text="&#xE81C;"
                                           Foreground="{DynamicResource ButtonColor}"
                                           Margin="0,0,15,0" Width="24"/>
                                <TextBlock Text="History" FontSize="15" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}" Tag="Favourite" Click="SideBarNavigate">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyphMd}" Text="&#xE734;"
                                           Foreground="{DynamicResource ButtonColor}"
                                           Margin="0,0,15,0" Width="24"/>
                                <TextBlock Text="Favorite" FontSize="15" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}" Tag="MyWords" Click="SideBarNavigate">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyphMd}" Text="&#xE736;"
                                           Foreground="{DynamicResource ButtonColor}"
                                           Margin="0,0,15,0" Width="24"/>
                                <TextBlock Text="My Words" FontSize="15" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}" Tag="Game" Click="SideBarNavigate">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyphMd}" Text="&#xE7FC;"
                                           Foreground="{DynamicResource ButtonColor}"
                                           Margin="0,0,15,0" Width="24"/>
                                <TextBlock Text="Game" FontSize="15" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}" Tag="Offline" Click="SideBarNavigate">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyphMd}" Text="&#xE896;"
                                           Foreground="{DynamicResource ButtonColor}"
                                           Margin="0,0,15,0" Width="24"/>
                                <TextBlock Text="Offline packages" FontSize="15" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}" Tag="Account" Click="SideBarNavigate">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyphMd}" Text="&#xE77B;"
                                           Foreground="{DynamicResource ButtonColor}"
                                           Margin="0,0,15,0" Width="24"/>
                                <TextBlock Text="Account" FontSize="15" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}" Tag="Setting" Click="SideBarNavigate">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyphMd}" Text="&#xE713;"
                                           Foreground="{DynamicResource ButtonColor}"
                                           Margin="0,0,15,0" Width="24"/>
                                <TextBlock Text="Setting" FontSize="15" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
